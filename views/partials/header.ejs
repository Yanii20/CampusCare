
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | CampusCare</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="<%= user ? 'signed-in' : 'signed-out' %>">

<aside class="topbar">
  <a class="brand" href="<%= user ? '/dashboard' : '/login' %>">
    <span class="brand-mark">✳</span>
    <span>
      CampusCare
      <small>MAINTENANCE PORTAL</small>
    </span>
  </a>

  <% if (user) { %>
    <div class="workspace-label">WORKSPACE</div>

    <nav class="nav" aria-label="Main navigation">

      <a href="/dashboard">
        <span aria-hidden="true">▦</span>
        Overview
      </a>

      <% if (["student", "faculty"].includes(user.role)) { %>
        <a href="/requests/mine">
          <span aria-hidden="true">▤</span>
          My requests
        </a>

        <a href="/requests/new">
          <span aria-hidden="true">＋</span>
          New request
        </a>
      <% } %>

      <% if (["admin", "staff"].includes(user.role)) { %>
        <a href="/requests/manage">
          <span aria-hidden="true">▤</span>
          Manage requests
        </a>

        <a href="/reports">
          <span aria-hidden="true">▥</span>
          Reports
        </a>
      <% } %>

      <% if (user.role === "admin") { %>
        <a href="/admin/users">
          <span aria-hidden="true">♙</span>
          Users
        </a>
      <% } %>

    </nav>

    <div class="sidebar-note">
      <span aria-hidden="true">✳</span>
      <h3>
        A better campus,<br>
        together.
      </h3>
      <p>Every request makes a little difference.</p>
    </div>

    <div class="account">
      <span class="avatar"><%= user.name.trim().split(/\s+/).map(part => part[0]).slice(0, 2).join('').toUpperCase() %></span>

      <span>
        <%= user.name %>
        <small><%= user.role %></small>
      </span>

      <form action="/logout" method="POST">
        <button
          class="button button-ghost button-small"
          type="submit"
          title="Log out"
          aria-label="Log out"
        >
          ↪
        </button>
      </form>
    </div>
  <% } %>
</aside>

<% if (user) { %>
  <header class="workspace-bar">
    <span>
      Workspace
      <span class="breadcrumb-slash">/</span>
      <strong><%= title %></strong>
    </span>

    <span class="portal-label">
      Campus maintenance portal
      <span class="online-dot"></span>
    </span>
  </header>
<% } %>

<main class="container">
  <% if (flash) { %>
    <div class="alert <%= flash.type %>" role="status">
      <%= flash.message %>
    </div>
  <% } %>
