<%- include("partials/header", { title, user, flash }) %>
<div class="page-heading"><div><div class="eyebrow">REQUEST DETAILS</div><h1>Request #<%= request.id %></h1><p class="muted">Submitted <%= request.created_at %></p></div><a class="button button-ghost" href="<%= ['admin','staff'].includes(user.role) ? '/requests/manage' : '/requests/mine' %>">← Back to requests</a></div>
<div class="detail-layout"><section class="panel detail-main"><div class="detail-title-row"><div><span class="status status-<%= request.status.toLowerCase().replace(" ", "-") %>"><%= request.status %></span><h2><%= request.title %></h2></div><span class="priority priority-<%= request.priority.toLowerCase() %>"><%= request.priority %> priority</span><% if (request.is_safety) { %><span class="priority priority-urgent">⚠ Safety concern</span><% } %></div>
<div class="detail-grid"><div><small>Category</small><strong><%= request.category %></strong></div><div><small>Location</small><strong><%= request.location %></strong></div><div><small>Submitted by</small><strong><%= request.requester_name %></strong></div><div><small>Assigned staff</small><strong><%= request.assigned_name || "Not assigned" %></strong></div></div>
<div class="description-block"><h3>Description</h3><p class="preserve-lines"><%= request.description %></p></div>
<div class="detail-meta"><span>Created: <%= request.created_at %></span><span>Last updated: <%= request.updated_at %></span></div></section>
<aside class="help-card"><div class="eyebrow">STATUS GUIDE</div><h3>What happens next?</h3><p><strong>Pending</strong><br><span class="muted">The request has been received and is waiting for action.</span></p><p><strong>In Progress</strong><br><span class="muted">Maintenance work is underway.</span></p><p><strong>Completed</strong><br><span class="muted">The reported work has been marked complete.</span></p></aside></div>
<%- include("partials/footer") %>