<%- include("partials/header", { title, user, flash }) %>
<div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>User management</h1><p class="muted">Review the accounts registered in CampusCare.</p></div></div>
<section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Created</th></tr></thead><tbody><% users.forEach(u => { %><tr><td><strong><%= u.name %></strong></td><td><%= u.email %></td><td><span class="role-pill"><%= u.role %></span></td><td><%= u.created_at %></td></tr><% }) %></tbody></table></div></section>
<%- include("partials/footer") %>
