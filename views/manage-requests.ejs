<%- include("partials/header", { title, user, flash }) %>
<div class="page-heading"><div><div class="eyebrow">FACILITIES OPERATIONS</div><h1>Manage requests</h1><p class="muted">Review submitted issues, assign staff, and update progress.</p></div></div>
<section class="panel table-panel">
<form class="filter-bar" method="GET" action="/requests/manage"><label>Filter by status<select name="status"><option value="">All statuses</option><% ["Pending","In Progress","Completed"].forEach(s => { %><option value="<%= s %>" <%= selectedStatus === s ? "selected" : "" %>><%= s %></option><% }) %></select></label><button class="button button-secondary button-small">Apply filter</button><a class="text-link" href="/requests/manage">Clear</a></form>
<% if (!requests.length) { %><div class="empty-state"><h3>No matching requests</h3><p>Try another status filter.</p></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Request</th><th>Submitted by</th><th>Location</th><th>Priority</th><th>Status / assignment</th><th>Details</th></tr></thead><tbody>
<% requests.forEach(r => { %><tr><td><strong>#<%= r.id %> · <%= r.title %></strong><small><%= r.category %></small></td><td><%= r.requester_name %></td><td><%= r.location %></td><td><span class="priority priority-<%= r.priority.toLowerCase() %>"><%= r.priority %></span></td><td><form method="POST" action="/requests/<%= r.id %>/update" class="inline-update"><select name="status" aria-label="Status for request <%= r.id %>"><% ["Pending","In Progress","Completed"].forEach(s => { %><option <%= r.status === s ? "selected" : "" %>><%= s %></option><% }) %></select><select name="assigned_to" aria-label="Assign request <%= r.id %>"><option value="">Unassigned</option><% staff.forEach(s => { %><option value="<%= s.id %>" <%= r.assigned_to === s.id ? "selected" : "" %>><%= s.name %></option><% }) %></select><button class="button button-primary button-small" type="submit">Save</button></form></td><td><a class="text-link" href="/requests/<%= r.id %>">Open</a></td></tr><% }) %>
</tbody></table></div><% } %>
</section>
<%- include("partials/footer") %>
