<%- include("partials/header", { title, user: null, flash }) %>
<section class="auth-layout">
  <div class="auth-intro"><div class="eyebrow">CAMPUS FACILITIES • SERVICE PORTAL</div><h1>A better campus starts with taking care of it.</h1><p>Report facility issues, follow progress, and help keep your campus safe and functional.</p><div class="feature-line">✓ Report problems in one place</div><div class="feature-line">✓ Track request progress</div><div class="feature-line">✓ Keep campus maintenance organized</div></div>
  <div class="panel auth-panel"><div class="eyebrow">WELCOME BACK</div><h2>Sign in to CampusCare</h2><p class="muted">Use your campus account to continue.</p>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="POST" action="/login" class="form-stack">
      <label>Sign in as<select name="login_as" required>
        <option value="requester">Requester</option>
        <option value="technician">Technician</option>
        <option value="admin">Administrator</option>
      </select></label>
      <label>Email address<input type="email" name="email" placeholder="you@campus.edu" required autocomplete="username"></label>
      <label>Password<input type="password" name="password" placeholder="Enter your password" required autocomplete="current-password"></label>
      <button class="button button-primary button-full" type="submit">Sign in</button>
    </form>
    <p class="auth-switch">New here? <a href="/register">Create an account</a></p>
    
  </div>
</section>
<%- include("partials/footer") %>