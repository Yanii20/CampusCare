
<%- include("partials/header", { title, user: null, flash }) %>

<section class="auth-layout">

  <div class="auth-intro">

    <div class="eyebrow">
      CAMPUS FACILITIES • SERVICE PORTAL
    </div>

    <h1>
      A better campus starts with taking care of it.
    </h1>

    <p>
      Report facility issues, follow progress, and help
      keep your campus safe and functional.
    </p>

    <div class="feature-line">
      ✓ Report problems in one place
    </div>

    <div class="feature-line">
      ✓ Track request progress
    </div>

    <div class="feature-line">
      ✓ Keep campus maintenance organized
    </div>

  </div>

  <div class="panel auth-panel">

    <div class="eyebrow">WELCOME BACK</div>

    <h2>Sign in to CampusCare</h2>

    <p class="muted">
      Sign in using your Requester or Maintenance Staff account.
    </p>

    <% if (error) { %>
      <div class="alert error">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/login" class="form-stack">

      <label for="email">
        Email address

        <input
          type="email"
          class="form-control"
          id="email"
          name="email"
          value=""
          placeholder="Enter your email address"
          autocomplete="username"
          required
        >
      </label>

      <label for="password">
        Password

        <input
          type="password"
          class="form-control"
          id="password"
          name="password"
          placeholder="Enter your password"
          autocomplete="current-password"
          required
        >
      </label>

      <button
        class="button button-primary button-full"
        type="submit"
      >
        Sign in
      </button>

    </form>

    <p class="auth-switch">
      New here?
      <a href="/register">
        Create a Requester or Maintenance Staff account
      </a>
    </p>

  </div>

</section>

<%- include("partials/footer") %>
