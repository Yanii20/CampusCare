<%- include("partials/header", { title, user, flash }) %>
<div class="page-heading">
  <div><div class="eyebrow">YOUR CAMPUS, TAKEN CARE OF</div><h1>Good day, <%= user.name.split(" ")[0] %> <span class="heading-spark">✳</span></h1><p class="muted"><%= ["admin","staff"].includes(user.role) ? "A clearer view of campus maintenance and the work ahead." : "A little care goes a long way. Here is how your requests are doing." %></p></div>
  <% if (["student","faculty"].includes(user.role)) { %><a class="button button-primary" href="/requests/new">＋ New request</a><% } else { %><a class="button button-primary" href="/requests/manage">Manage requests →</a><% } %>
</div>
<div class="stats-grid">
  <div class="stat-card"><div class="stat-top"><span class="stat-label">Total requests</span><span class="stat-icon" aria-hidden="true">▤</span></div><strong><%= String(counts.total).padStart(2,'0') %></strong><span class="stat-foot">All recorded requests</span></div>
  <div class="stat-card stat-pending"><div class="stat-top"><span class="stat-label">Pending</span><span class="stat-icon" aria-hidden="true">◷</span></div><strong><%= String(counts.pending).padStart(2,'0') %></strong><span class="stat-foot">Awaiting staff review</span></div>
  <div class="stat-card stat-progress"><div class="stat-top"><span class="stat-label">In progress</span><span class="stat-icon" aria-hidden="true">⚒</span></div><strong><%= String(counts.progress).padStart(2,'0') %></strong><span class="stat-foot">Being worked on</span></div>
  <div class="stat-card stat-completed"><div class="stat-top"><span class="stat-label">Completed</span><span class="stat-icon" aria-hidden="true">✓</span></div><strong><%= String(counts.completed).padStart(2,'0') %></strong><span class="stat-foot">✓ Resolved and ready to go</span></div>
</div>
<section class="panel table-panel">
  <div class="section-heading"><div><h2>Recent requests</h2><p class="muted">A quick look at the latest campus reports.</p></div><a href="<%= ['admin','staff'].includes(user.role) ? '/requests/manage' : '/requests/mine' %>" class="text-link">View all requests →</a></div>
  <% if (!recent.length) { %><div class="empty-state"><div class="empty-icon">▤</div><h3>No requests yet</h3><p>Maintenance requests will appear here after they are submitted.</p><% if (["student","faculty"].includes(user.role)) { %><a class="button button-primary" href="/requests/new">Submit first request</a><% } %></div>
  <% } else { %><div class="table-wrap"><table><thead><tr><th>Request</th><th>Location</th><% if (["admin","staff"].includes(user.role)) { %><th>Submitted by</th><% } %><th>Priority</th><th>Status</th><th></th></tr></thead><tbody>
  <% recent.forEach(r => { %><tr><td><strong><%= r.title %></strong><small>#<%= r.id %> · <%= r.category %></small></td><td><%= r.location %></td><% if (["admin","staff"].includes(user.role)) { %><td><%= r.requester_name %></td><% } %><td><span class="priority priority-<%= r.priority.toLowerCase() %>"><%= r.priority %></span></td><td><span class="status status-<%= r.status.toLowerCase().replace(' ', '-') %>"><%= r.status %></span></td><td><a class="text-link" href="/requests/<%= r.id %>">Details ↗</a></td></tr><% }) %>
  </tbody></table></div><% } %>
</section>
<%- include("partials/footer") %>