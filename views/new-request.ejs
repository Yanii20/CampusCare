<%- include("partials/header", { title, user, flash }) %>
<div class="page-heading"><div><div class="eyebrow">REPORT AN ISSUE</div><h1>New maintenance request</h1><p class="muted">Share the details so campus staff can understand and resolve the problem.</p></div><a href="/requests/mine" class="button button-ghost">My requests</a></div>
<div class="form-layout"><section class="panel"><% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form method="POST" action="/requests" class="form-stack">
  <label>Request title <span class="required">*</span><input name="title" value="<%= form.title || '' %>" maxlength="100" placeholder="e.g. Broken light in Room 204" required></label>
  <div class="form-row"><label>Category <span class="required">*</span><select name="category" required><option value="">Select category</option><% ["Electrical","Plumbing","Furniture","Air Conditioning","Cleaning","Other"].forEach(c => { %><option <%= form.category === c ? "selected" : "" %>><%= c %></option><% }) %></select></label>
  <label>Priority<select name="priority"><% ["Low","Normal","High","Urgent"].forEach(p => { %><option <%= (form.priority || "Normal") === p ? "selected" : "" %>><%= p %></option><% }) %></select></label></div>
  <label>Building / room / location <span class="required">*</span><input name="location" value="<%= form.location || '' %>" maxlength="120" placeholder="e.g. Main Building, Room 204" required></label>
  <label><span><input type="checkbox" name="is_safety" <%= form.is_safety ? "checked" : "" %>> This is a safety concern (e.g., broken lock, faulty lighting, exposed wiring)</span></label>
  <label>Description <span class="required">*</span><textarea name="description" rows="6" maxlength="1500" placeholder="Describe the issue and any useful details..." required><%= form.description || '' %></textarea><small>Maximum 1,500 characters. Please do not include passwords or other sensitive information.</small></label>
  <div class="form-actions"><a href="/dashboard" class="button button-ghost">Cancel</a><button type="submit" class="button button-primary">Submit request →</button></div>
</form></section>
<aside class="help-card"><div class="help-icon">✦</div><h3>Tips for a useful report</h3><ul><li>Choose the exact building and room.</li><li>Describe what is broken or needs attention.</li><li>Choose Urgent only for issues that need immediate attention.</li></ul><p class="muted">After submitting, you can track the request from My Requests.</p></aside></div>
<%- include("partials/footer") %>