
<%- include("partials/header", { title, user, flash }) %>

<div class="page-heading">
  <div>
    <div class="eyebrow">REPORT AN ISSUE</div>
    <h1>New maintenance request</h1>
    <p class="muted">
      Share the details so campus staff can understand and resolve the problem.
    </p>
  </div>
  <a href="/requests/mine" class="button button-ghost">My requests</a>
</div>

<div class="form-layout">
  <section class="panel">
    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>

    <form method="POST" action="/requests" class="form-stack" id="request-form">

      <label for="request-title">
        Request title <span class="required">*</span>
        <input
          id="request-title"
          name="title"
          value="<%= form.title || '' %>"
          maxlength="100"
          placeholder="e.g. Broken light in Room 204"
          required
        >
        <small>
          <span id="title-count"><%= (form.title || '').length %></span>/100 characters
        </small>
      </label>

      <div class="form-row">
        <label for="request-category">
          Category <span class="required">*</span>
          <select id="request-category" name="category" required>
            <option value="">Select category</option>
            <% ["Electrical", "Plumbing", "Furniture", "Air Conditioning", "Cleaning", "Other"].forEach(c => { %>
              <option value="<%= c %>" <%= form.category === c ? "selected" : "" %>>
                <%= c %>
              </option>
            <% }) %>
          </select>
        </label>

        <label for="request-priority">
          Priority
          <select id="request-priority" name="priority">
            <% ["Low", "Normal", "High", "Urgent"].forEach(p => { %>
              <option value="<%= p %>" <%= (form.priority || "Normal") === p ? "selected" : "" %>>
                <%= p %>
              </option>
            <% }) %>
          </select>
        </label>
      </div>

      <label for="request-location">
        Building / room / location <span class="required">*</span>
        <input
          id="request-location"
          name="location"
          value="<%= form.location || '' %>"
          maxlength="120"
          placeholder="e.g. Main Building, Room 204"
          required
        >
        <small>
          <span id="location-count"><%= (form.location || '').length %></span>/120 characters
        </small>
      </label>

      <label for="request-description">
        Description <span class="required">*</span>
        <textarea
          id="request-description"
          name="description"
          rows="6"
          maxlength="1500"
          placeholder="Describe the issue and any useful details..."
          required
        ><%= form.description || '' %></textarea>
        <small>
          <span id="description-count"><%= (form.description || '').length %></span>/1500 characters.
          Please do not include passwords or other sensitive information.
        </small>
      </label>

      <div class="form-actions">
        <a href="/dashboard" class="button button-ghost">Cancel</a>
        <button type="submit" class="button button-primary">
          Submit request →
        </button>
      </div>
    </form>
  </section>

  <aside class="help-card">
    <div class="help-icon">✦</div>
    <h3>Tips for a useful report</h3>
    <ul>
      <li>Choose the exact building and room.</li>
      <li>Describe what is broken or needs attention.</li>
      <li>Choose Urgent only for issues that need immediate attention.</li>
    </ul>
    <p class="muted">
      After submitting, you can track the request from My Requests.
    </p>
  </aside>
</div>

<script>
  const characterFields = [
    {
      inputId: "request-title",
      countId: "title-count"
    },
    {
      inputId: "request-location",
      countId: "location-count"
    },
    {
      inputId: "request-description",
      countId: "description-count"
    }
  ];

  characterFields.forEach(function (field) {
    const input = document.getElementById(field.inputId);
    const counter = document.getElementById(field.countId);

    function updateCounter() {
      counter.textContent = input.value.length;
    }

    input.addEventListener("input", updateCounter);
    updateCounter();
  });
</script>

<%- include("partials/footer") %>
